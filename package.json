{
  "name": "md-workstation",
  "private": true,
  "description": "MD Workstation（PWA と Mac 版）。画面は app/、Mac 版は mac/",
  "scripts": {
    "build": "node scripts/build-app.js",
    "check": "node scripts/build-app.js --check && node scripts/check-sw.js",
    "test": "npm run check && npm run test:unit && npm run test:mac && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:mac": "cd mac && node test/backend.test.js",
    "test:e2e": "playwright test",
    "test:electron": "node mac/scripts/copy-app.js && node tests/electron/notes.e2e.js",
    "serve": "node scripts/serve.js 8765"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
